# Database
DATABASE_URL=postgresql+asyncpg://rabbit:rabbit_secret@localhost:5432/rabbit_hole

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# LLM -- free-tier provider chain, tried in order (app/nlp/llm.py). Leave any key
# blank to skip that provider; if every provider is blank/fails, extraction falls
# back to local spaCy and summaries fall back to raw passage concatenation.
# Order/providers to try can be changed via LLM_PROVIDER_CHAIN below.
#
# Each key below accepts a single key OR several comma-separated keys, e.g.
# GEMINI_API_KEY=key1,key2,key3 -- each is a separate free-tier account with its
# own rate-limit bucket, so more keys raise that provider's effective throughput.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
LLM_PROVIDER_CHAIN=gemini,groq,cerebras,mistral,anthropic

# Relation classification (nlp/extraction.py::classify_relations_ensemble): how many
# distinct providers to consult concurrently and cross-check for agreement, instead
# of trusting one model's self-reported confidence. Needs that many providers
# actually configured above; otherwise it silently falls back to a single call.
RELATION_ENSEMBLE_SIZE=2

# Optional, no free tier -- only used if a key is actually set, and normally last
# in LLM_PROVIDER_CHAIN.
ANTHROPIC_API_KEY=

# Source APIs
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=RabbitHoleExplorer/1.0

SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here

# Web search: SerpAPI tried first, then Serper. Each accepts one key or several
# comma-separated keys ("key1,key2") for multiple free-tier accounts.
SERPAPI_KEY=your_serpapi_key_here
SERPER_API_KEY=your_serper_key_here

# App settings
SECRET_KEY=change_this_to_a_random_secret_key
ENVIRONMENT=development
LOG_LEVEL=INFO
# Optional: also write logs to a rotating file (5MB x 3). Stdout logging is always on.
LOG_FILE=
